<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LocationTracker.ViewModels"
             x:Class="LocationTracker.Views.MainPage"
             x:DataType="vm:MainViewModel"
             Title="Location Tracker" BackgroundColor="#F6F5FB">
    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="0">
        <VerticalStackLayout BackgroundColor="#512BD4" Padding="20,14" Spacing="3">
            <Label Text="Location Tracker" FontSize="25" FontFamily="OpenSansSemibold" TextColor="White" />
            <Label Text="Your movements, mapped over time" FontSize="12" TextColor="#E5DFFF" />
        </VerticalStackLayout>
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Padding="18,12" ColumnSpacing="12">
            <VerticalStackLayout Spacing="4">
                <Label Text="{Binding StatusMessage}" FontSize="13" TextColor="#252238" />
                <Label Text="{Binding LastReadingText}" FontSize="11" TextColor="#686378" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                <Label Text="{Binding SampleCount}" FontSize="24" FontFamily="OpenSansSemibold" TextColor="#512BD4" HorizontalTextAlignment="Center" />
                <Label Text="SAMPLES" FontSize="9" TextColor="#686378" />
            </VerticalStackLayout>
        </Grid>
        <Grid Grid.Row="2" MinimumHeightRequest="180">
            <ContentView x:Name="MapHost" />
            <Border x:Name="MapNotice" IsVisible="False" BackgroundColor="#FFF5DA" Padding="14" Margin="12"
                    VerticalOptions="Start" StrokeThickness="0">
                <Label x:Name="MapNoticeText" FontSize="12" TextColor="#493A12" />
            </Border>
        </Grid>
        <VerticalStackLayout Grid.Row="3" Padding="16,10,16,12" Spacing="8">
            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                <Label Text="Density" FontSize="11" TextColor="#686378" />
                <Label Text="● Low" FontSize="11" TextColor="#1477DF" />
                <Label Text="● Medium" FontSize="11" TextColor="#A46300" />
                <Label Text="● High" FontSize="11" TextColor="#D5264B" />
            </HorizontalStackLayout>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Text="Start Tracking" Command="{Binding StartTrackingCommand}" AutomationId="StartTrackingButton" />
                <Button Grid.Column="1" Text="Stop Tracking" Command="{Binding StopTrackingCommand}" AutomationId="StopTrackingButton" />
            </Grid>
            <Grid ColumnDefinitions="2*,*" ColumnSpacing="10">
                <Button Text="Center on Current Location" FontSize="11" Padding="8" Command="{Binding CenterCommand}" AutomationId="CenterButton"
                        BackgroundColor="#EAE5FA" TextColor="#4121A6" />
                <Button Grid.Column="1" Text="Clear History" FontSize="12" Padding="8" Command="{Binding ClearHistoryCommand}" AutomationId="ClearHistoryButton"
                        BackgroundColor="#FBE8ED" TextColor="#9E2040" />
            </Grid>
            <Label Text="Foreground only · History stored on this device" FontSize="10" TextColor="#686378" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
